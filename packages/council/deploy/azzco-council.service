[Unit]
Description=AZZCO Council AI Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/azzco-council/core
EnvironmentFile=/etc/azzco-council.env
ExecStart=/usr/bin/node /opt/azzco-council/core/src/server.js
Restart=always
RestartSec=5
User=azzco
Group=azzco
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# Council writes to its data/ directory for route log and budget state
ReadWritePaths=/opt/azzco-council/core/data

# Standard output to journal (journalctl -u azzco-council -f)
StandardOutput=append:/var/log/azzco/council.log
StandardError=append:/var/log/azzco/council-error.log

[Install]
WantedBy=multi-user.target
