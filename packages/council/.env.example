# ─── VBOARD Council Core ───────────────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# Bind address — use 127.0.0.1 in production (never 0.0.0.0 unless behind a
# firewall / reverse proxy with IP allowlist)
VBOARD_COUNCIL_HOST=127.0.0.1
VBOARD_COUNCIL_PORT=8787

# Bearer token for authenticating calls from ops-core / runners
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VBOARD_COUNCIL_TOKEN=

# AI Provider keys — only set the provider(s) you use
LLM_API_TOKEN=
LLM_FALLBACK_API_KEY=

# Daily spend ceiling in USD (default: 3.00)
VBOARD_DAILY_BUDGET_USD=3.00
VBOARD_MONTHLY_BUDGET_USD=90.00

# Route log file path (default: data/route_log.jsonl relative to working dir)
VBOARD_ROUTE_LOG=

# Data directory for budget state persistence
VBOARD_DATA_DIR=./data
