# ─── Meeting Room ─────────────────────────────────────────────────────────────
# Copy to .env and fill in values. Never commit .env.

# REQUIRED in production
MEETING_ROOM_API_TOKEN=change-me-long-random-secret
MEETING_ROOM_REQUIRE_TOKEN=true

# Bind address and port (default: 127.0.0.1:8790)
MEETING_ROOM_HOST=127.0.0.1
MEETING_ROOM_PORT=8790

# Evidence store (meeting transcripts + audit chain)
AZZCO_DATA_ROOT=/workspace

# ─── AI Providers (at least one required for council) ─────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ─── Voice / STT ──────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=         # TTS — voice synthesis per advisor
GROQ_API_KEY=               # STT — Groq Whisper transcription

# ─── Avatar (optional) ────────────────────────────────────────────────────────
TAVUS_API_KEY=              # Tavus video avatar (BYOK or server-side key)
TAVUS_BASE_URL=https://tavusapi.com

# ─── LiveKit (Phase 2 — optional) ────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Council AI model overrides (optional) ────────────────────────────────────
COUNCIL_PRIMARY_MODEL=claude-sonnet-4-5-20250929
COUNCIL_REVIEWER_1_MODEL=gpt-4o
COUNCIL_REVIEWER_2_MODEL=gemini-2.5-flash
COUNCIL_CHAIRMAN_MODEL=gemini-2.5-flash

# ─── Request / audio size limits (optional, tune after load testing) ──────────
# MEETING_ROOM_MAX_REQUEST_BYTES=14680064      # 14 MB
# MEETING_ROOM_MAX_AUDIO_BYTES=10485760        # 10 MB
# MEETING_ROOM_MAX_TRANSCRIPT_CHARS=20000
# MEETING_ROOM_MAX_CONTEXT_CHARS=60000
# MEETING_ROOM_MAX_TTS_CHARS=2000
# MEETING_ROOM_MAX_ROOM_ID_CHARS=160
