# Copy to /etc/azzco-ops-core.env on the target server and fill in all values.
# The systemd unit reads this file via EnvironmentFile=.

# ── API ────────────────────────────────────────────────────────────────────────
AZZCO_API_HOST=127.0.0.1
AZZCO_API_PORT=8788
# REQUIRED — generate with: openssl rand -hex 32
AZZCO_API_TOKEN=REPLACE_WITH_STRONG_TOKEN
AZZCO_API_KEYS_FILE=/var/lib/azzco-ops-core/.secrets/api_keys.json

# ── Data ──────────────────────────────────────────────────────────────────────
AZZCO_DATA_ROOT=/var/lib/azzco-ops-core
AZZCO_SERVER_NAME=hostinger-or-ovh
AZZCO_LOG_DIR=/var/lib/azzco-ops-core/ops/logs

# ── OVH Council bridge ────────────────────────────────────────────────────────
# URL of the OVH council endpoint (only called for ovh_required routes)
AZZCO_COUNCIL_URL=http://57.130.58.222:8787/route
# Token accepted by the council endpoint
AZZCO_COUNCIL_TOKEN=REPLACE_WITH_COUNCIL_TOKEN
# Timeout in ms (default 120000)
AZZCO_COUNCIL_TIMEOUT_MS=120000

# ── Owner contact ────────────────────────────────────────────────────────────
# Used by incident playbook to notify owner
AZZCO_OWNER_WHATSAPP=+33XXXXXXXXX
AZZCO_OWNER_TELEGRAM=XXXXXXXXX

# ── Limits ────────────────────────────────────────────────────────────────────
AZZCO_MAX_EVIDENCE_ITEMS=30
AZZCO_MAX_TEXT_CHARS=6000

# Optional server-side Supabase log sink. Never expose SERVICE_ROLE in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AZZCO_SUPABASE_EVENTS_TABLE=azzco_api_events
