[Unit]
Description=AZZCO Ops Core API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/azzco-ops-core
EnvironmentFile=/etc/azzco-ops-core.env
ExecStart=/usr/bin/node /opt/azzco-ops-core/src/cli.js api
Restart=always
RestartSec=5
User=azzco
Group=azzco
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/azzco-ops-core

[Install]
WantedBy=multi-user.target
