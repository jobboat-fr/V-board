# Copy to /etc/vboard-ops-core.env on the target server and fill in all values.
# The systemd unit reads this file via EnvironmentFile=.

# ── API ────────────────────────────────────────────────────────────────────────
VBOARD_API_HOST=127.0.0.1
VBOARD_API_PORT=8788
# REQUIRED — generate with: openssl rand -hex 32
VBOARD_API_TOKEN=REPLACE_WITH_STRONG_TOKEN
VBOARD_API_KEYS_FILE=/var/lib/vboard-ops-core/.secrets/api_keys.json

# ── Data ──────────────────────────────────────────────────────────────────────
VBOARD_DATA_ROOT=/var/lib/vboard-ops-core
VBOARD_SERVER_NAME=front-desk-or-back-office
VBOARD_LOG_DIR=/var/lib/vboard-ops-core/ops/logs

# ── back office Council bridge ────────────────────────────────────────────────────────
# URL of the back office council endpoint (only called for back-office_required routes)
VBOARD_COUNCIL_URL=http://203.0.113.10:8787/route
# Token accepted by the council endpoint
VBOARD_COUNCIL_TOKEN=REPLACE_WITH_COUNCIL_TOKEN
# Timeout in ms (default 120000)
VBOARD_COUNCIL_TIMEOUT_MS=120000

# ── Owner contact ────────────────────────────────────────────────────────────
# Used by incident playbook to notify owner
VBOARD_OWNER_WHATSAPP=+33XXXXXXXXX
VBOARD_OWNER_TELEGRAM=XXXXXXXXX

# ── Limits ────────────────────────────────────────────────────────────────────
VBOARD_MAX_EVIDENCE_ITEMS=30
VBOARD_MAX_TEXT_CHARS=6000

# Optional server-side Supabase log sink. Never expose SERVICE_ROLE in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VBOARD_SUPABASE_EVENTS_TABLE=vboard_api_events
