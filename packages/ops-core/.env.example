AZZCO_API_HOST=127.0.0.1
AZZCO_API_PORT=8788
# REQUIRED in production — set a strong random token (e.g. openssl rand -hex 32)
AZZCO_API_TOKEN=REPLACE_WITH_STRONG_TOKEN
AZZCO_API_KEYS_FILE=./.secrets/api_keys.json
AZZCO_DATA_ROOT=./data
AZZCO_SERVER_NAME=local-dev
AZZCO_LOG_DIR=./data/ops/logs
AZZCO_COUNCIL_URL=http://127.0.0.1:8787/route
# Required for ovh_required flows — token accepted by the OVH council endpoint
AZZCO_COUNCIL_TOKEN=
# Owner contact channels (used by incident playbook notifications)
AZZCO_OWNER_WHATSAPP=+33XXXXXXXXX
AZZCO_OWNER_TELEGRAM=XXXXXXXXX
AZZCO_MAX_EVIDENCE_ITEMS=30
AZZCO_MAX_TEXT_CHARS=6000

# Optional server-side Supabase log sink. Never expose SERVICE_ROLE in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AZZCO_SUPABASE_EVENTS_TABLE=azzco_api_events
