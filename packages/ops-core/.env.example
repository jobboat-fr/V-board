VBOARD_API_HOST=127.0.0.1
VBOARD_API_PORT=8788
# REQUIRED in production — set a strong random token (e.g. openssl rand -hex 32)
VBOARD_API_TOKEN=REPLACE_WITH_STRONG_TOKEN
VBOARD_API_KEYS_FILE=./.secrets/api_keys.json
VBOARD_DATA_ROOT=./data
VBOARD_SERVER_NAME=local-dev
VBOARD_LOG_DIR=./data/ops/logs
VBOARD_COUNCIL_URL=http://127.0.0.1:8787/route
# Required for back-office_required flows — token accepted by the back office council endpoint
VBOARD_COUNCIL_TOKEN=
# Owner contact channels (used by incident playbook notifications)
VBOARD_OWNER_WHATSAPP=+33XXXXXXXXX
VBOARD_OWNER_TELEGRAM=XXXXXXXXX
VBOARD_MAX_EVIDENCE_ITEMS=30
VBOARD_MAX_TEXT_CHARS=6000

# Optional server-side event sink. Never expose this token in browser code.
VBOARD_EVENT_SINK_ENABLED=false
VBOARD_EVENT_SINK_URL=
VBOARD_EVENT_SINK_TOKEN=
VBOARD_EVENT_SINK_TOKEN_HEADER=authorization
