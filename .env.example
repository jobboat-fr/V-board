# ─────────────────────────────────────────────────────────────────────────────
# AZZCO V-Board — root environment template
#
# Copy to .env and fill in your values.
# This file is checked into git — do NOT put real secrets here.
#
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────


# ── Shared secrets (used by multiple services) ────────────────────────────────

# Bearer token that runner/ops-core use to authenticate with council
# Minimum 32 random bytes: openssl rand -hex 32
AZZCO_COUNCIL_TOKEN=

# Bearer token for ops-core HTTP API
# Minimum 32 random bytes: openssl rand -hex 32
AZZCO_API_TOKEN=


# ── ops-core ──────────────────────────────────────────────────────────────────

# Bind address — keep 127.0.0.1 unless behind a reverse proxy
OPS_CORE_HOST=127.0.0.1
OPS_CORE_PORT=8788

# JSON-encoded scoped API keys (alternative to AZZCO_API_TOKEN for multi-key setups)
# Format: {"keys":[{"id":"...","name":"...","hash":"...","scopes":"route:read,..."}]}
AZZCO_API_KEYS_JSON=

# Log level: error | warn | info | debug
AZZCO_LOG_LEVEL=info

# Supabase observability sink (optional)
AZZCO_SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=


# ── council ───────────────────────────────────────────────────────────────────

# LLM providers — fill in whichever you use
HUGGINGFACE_TOKEN=
TOGETHER_API_KEY=

# Daily AI spend cap in USD (hard ceiling enforced by cost_guard.js)
AZZCO_DAILY_BUDGET_USD=3.00

# Set to "1" to force all LLM calls to cheapest/local model
AZZCO_FORCE_CHEAP_MODE=0


# ── runner ────────────────────────────────────────────────────────────────────

# Owner WhatsApp number for report delivery (E.164 format)
AZZCO_OWNER_WHATSAPP=

# Assistant/relay WhatsApp number (if using a separate relay account)
AZZCO_ASSISTANT_WHATSAPP=

# WhatsApp API (e.g. WA Business Cloud, WA-Web gateway, Twilio)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Gmail OAuth credentials (base64-encoded JSON files)
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=

# Qonto API auth (login:secret)
QONTO_AUTH=

# Max emails to inspect per mail_triage run
MAIL_TRIAGE_LIMIT=20

# Override crontab file path inside runner container
# AZZCO_CRONTAB_FILE=/etc/azzco-crontab


# ── meeting-room ─────────────────────────────────────────────────────────────

# Bearer token for meeting-room HTTP API
# Minimum 32 random bytes: openssl rand -hex 32
MEETING_ROOM_API_TOKEN=

# Bind address (keep 127.0.0.1 — put nginx in front for HTTPS)
MEETING_ROOM_HOST=127.0.0.1
MEETING_ROOM_PORT=8790

# AI providers for the 5-stage advisor council (at least one required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Voice channels (optional — leave empty to disable)
ELEVENLABS_API_KEY=       # TTS voice synthesis per advisor
GROQ_API_KEY=             # STT Groq Whisper transcription

# Tavus video avatar (optional)
TAVUS_API_KEY=
TAVUS_BASE_URL=https://tavusapi.com

# LiveKit real-time media (Phase 2 — optional)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# ── optional: local LLM via Ollama ────────────────────────────────────────────
# Enable with: docker compose --profile ollama up -d
# OLLAMA_MODEL=mistral:7b
