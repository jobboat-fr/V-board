# VBOARD V-Board â€” root environment template
#
# Copy to .env and fill in your values.
# This file is checked into git â€” do NOT put real secrets here.
#
# cp .env.example .env
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€


# â”€â”€ Hermes Agent runtime â€” V-Board is deployed as a Hermes fork â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
#
# V-Board runs on top of Hermes Agent (NousResearch). The variables below
# configure the Hermes runtime that is part of this fork â€” LLM provider,
# channel gateway, workspace paths, and token budgets.
#
# The “agent_runtime” binary used by runner cron scripts IS the Hermes binary
# included in the fork. No separate install needed on a fork deployment.
#
# Migrating from OpenClaw? Run: hermes claw migrate
#
# See docs/AGENT_RUNTIME.md for fork structure, workspace layout, and cron job registration.

# LLM provider for the agent runtime (hermes model to switch)
# Options: openrouter, nous_portal, novitaai, openai, ollama, huggingface
HERMES_PROVIDER=openrouter
HERMES_API_KEY=

# Model used by runner scripts and agent tasks
# (meeting-room council uses PRIMARY_LLM_API_KEY / REVIEWER_LLM_API_KEY instead)
HERMES_MODEL=openai/gpt-4o-mini

# Workspace path â€” must match VBOARD_WORKSPACE and the Docker volume mount
AGENT_RUNTIME_WORKSPACE=/workspace
AGENT_RUNTIME_STATE_DIR=/data/.agent_runtime

# Token budget enforcement (replaces openclaw_token_governor if migrating)
HERMES_TOKEN_BUDGET_DAILY=750000
HERMES_TOKEN_BUDGET_PER_JOB=200000

# Telegram gateway â€” recommended for owner notifications
HERMES_TELEGRAM_TOKEN=
HERMES_TELEGRAM_OWNER_ID=

# OpenClaw migration (only if coming from an existing OpenClaw install)
# Run: hermes claw migrate
# OPENCLAW_JOBS_PATH=/workspace/.agent_runtime/cron/jobs.json


# â”€â”€ Shared secrets (used by multiple services) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Bearer token that runner/ops-core use to authenticate with council
# Minimum 32 random bytes: openssl rand -hex 32
VBOARD_COUNCIL_TOKEN=

# Bearer token for ops-core HTTP API
# Minimum 32 random bytes: openssl rand -hex 32
VBOARD_API_TOKEN=


# â”€â”€ ops-core â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Bind address â€” keep 127.0.0.1 unless behind a reverse proxy
OPS_CORE_HOST=127.0.0.1
OPS_CORE_PORT=8788

# JSON-encoded scoped API keys (alternative to VBOARD_API_TOKEN for multi-key setups)
# Format: {"keys":[{"id":"...","name":"...","hash":"...","scopes":"route:read,..."}]}
VBOARD_API_KEYS_JSON=

# Log level: error | warn | info | debug
VBOARD_LOG_LEVEL=info

# Optional server-side event sink (generic REST endpoint)
VBOARD_EVENT_SINK_ENABLED=false
VBOARD_EVENT_SINK_URL=
VBOARD_EVENT_SINK_TOKEN=
VBOARD_EVENT_SINK_TOKEN_HEADER=authorization


# â”€â”€ council â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# LLM providers â€” fill in whichever you use
LLM_API_TOKEN=
LLM_FALLBACK_API_KEY=

# Daily AI spend cap in USD (hard ceiling enforced by cost_guard.js)
VBOARD_DAILY_BUDGET_USD=3.00

# Set to "1" to force all LLM calls to cheapest/local model
VBOARD_FORCE_CHEAP_MODE=0


# â”€â”€ runner â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Owner WhatsApp number for report delivery (E.164 format)
VBOARD_OWNER_WHATSAPP=

# Assistant/relay WhatsApp number (if using a separate relay account)
VBOARD_ASSISTANT_WHATSAPP=

# WhatsApp API (e.g. WA Business Cloud, WA-Web gateway, Twilio)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Gmail OAuth credentials (base64-encoded JSON files)
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=

# your bank API API auth (login:secret)
BANK_API_AUTH=

# Max emails to inspect per mail_triage run
MAIL_TRIAGE_LIMIT=20

# Override crontab file path inside runner container
# VBOARD_CRONTAB_FILE=/etc/vboard-crontab


# â”€â”€ meeting-room â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Bearer token for meeting-room HTTP API
# Minimum 32 random bytes: openssl rand -hex 32
MEETING_ROOM_API_TOKEN=

# Bind address (keep 127.0.0.1 â€” put nginx in front for HTTPS)
MEETING_ROOM_HOST=127.0.0.1
MEETING_ROOM_PORT=8790

# AI providers for the 5-stage advisor council (at least one required)
PRIMARY_LLM_API_KEY=
REVIEWER_LLM_API_KEY=
CHAIR_LLM_API_KEY=

# Voice channels (optional â€” leave empty to disable)
VOICE_API_KEY=       # TTS voice synthesis per advisor
STT_API_KEY=             # STT speech-to-text provider Whisper transcription

# avatar provider video avatar (optional)
AVATAR_API_KEY=
AVATAR_API_BASE_URL=https://avatar-provider.example

# LiveKit real-time media (Phase 2 â€” optional)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# â”€â”€ optional: local LLM via Ollama â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Enable with: docker compose --profile ollama up -d
# OLLAMA_MODEL=mistral:7b

